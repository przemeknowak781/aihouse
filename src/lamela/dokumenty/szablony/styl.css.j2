{#- Arkusz stylów opracowania projektowego (A4 pionowo, oprawa po lewej: margines 25 mm).
    Szablon Jinja: teksty nagłówka/stopki (pola marginesowe @page) wstawia Dokument. -#}
:root {
  --ink: #1c2229;
  --akcent: #1f3b57;
  --akcent-j: #6f8499;
  --linia: #b7c0ca;
  --linia-m: #d5dbe2;
  --tlo-nagl: #e9edf2;
  --tlo-jasne: #f5f7f9;
  --szary: #5b6672;
  --czerw: #a3262a;
}

@page {
  size: A4 portrait;
  margin: 24mm 15mm 19mm 25mm;
  @top-left {
    content: "{{ naglowek_lewy }}";
    font: 7.2pt "Liberation Sans", "DejaVu Sans", sans-serif; letter-spacing: 0.02em; color: #5b6672;
    vertical-align: bottom; padding-bottom: 2.2mm; border-bottom: 0.5pt solid #9aa5b1; width: 58%;
  }
  @top-right {
    content: "{{ naglowek_prawy }}";
    font: bold 7.2pt "Liberation Sans", "DejaVu Sans", sans-serif; color: #1f3b57; text-align: right;
    vertical-align: bottom; padding-bottom: 2.2mm; border-bottom: 0.5pt solid #9aa5b1; width: 42%;
  }
  @bottom-left {
    content: "{{ stopka_lewa }}";
    font: 6.8pt "Liberation Sans", "DejaVu Sans", sans-serif; color: {{ '#a3262a' if przyklad else '#5b6672' }};
    vertical-align: top; padding-top: 2mm; border-top: 0.5pt solid #9aa5b1; width: 64%;
  }
  @bottom-center { content: ""; border-top: 0.5pt solid #9aa5b1; }
  @bottom-right {
    content: "{{ stopka_prawa }}strona " counter(page) " z " counter(pages);
    font: 7.2pt "Liberation Sans", "DejaVu Sans", sans-serif; color: #1c2229; text-align: right;
    vertical-align: top; padding-top: 2mm; border-top: 0.5pt solid #9aa5b1; width: 36%;
  }
}
/* strona tytułowa elementu — bez nagłówka i stopki (liczy się jako strona 1) */
@page tytulowa {
  margin: 14mm 14mm 14mm 25mm;
  @top-left { content: none; border: none } @top-right { content: none; border: none }
  @bottom-left { content: none; border: none } @bottom-center { content: none; border: none }
  @bottom-right { content: none; border: none }
}
/* strona tytułowa wewnętrzna (np. informacja BIOZ w elemencie ZL) — bez nagłówka, z numerem strony */
@page tytul-wew {
  @top-left { content: none; border: none } @top-right { content: none; border: none }
}

html { font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif; font-size: 9.6pt; color: var(--ink);
       line-height: 1.42; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
body { margin: 0; }
p { margin: 0 0 2.2mm; text-align: justify; orphans: 3; widows: 3; }
a { color: inherit; text-decoration: none; }
b, strong { font-weight: bold; }
sub, sup { font-size: 70%; line-height: 0; }
.mn { font-size: 8.2pt; color: var(--szary); }
.nowa-strona { break-before: page; }
.bez-podzialu { break-inside: avoid; }
hr { border: none; border-top: 0.5pt solid var(--linia); margin: 4mm 0; }

/* ------------------------------------------------------------------------------------------ nagłówki */
.nagl { display: flex; align-items: baseline; gap: 3mm; break-after: avoid; break-inside: avoid; margin: 0; }
.nagl .nr { flex: 0 0 auto; min-width: 8mm; }
.nagl .t { flex: 1 1 auto; }
.nagl .podst { flex: 0 0 auto; font-size: 6.9pt; font-weight: normal; color: var(--akcent-j); letter-spacing: 0.02em;
               text-transform: none; white-space: nowrap; }
.nagl.g1 { font-size: 12pt; font-weight: bold; color: var(--akcent); margin: 7.5mm 0 3mm; padding-bottom: 1.3mm;
           border-bottom: 0.9pt solid var(--akcent); }
.nagl.g1 .nr { min-width: 9mm; }
.nagl.g2 { font-size: 10.2pt; font-weight: bold; color: var(--ink); margin: 5mm 0 2mm; }
.nagl.g3 { font-size: 9.6pt; font-weight: bold; font-style: italic; color: var(--ink); margin: 3.5mm 0 1.5mm; }
.nagl.g4 { font-size: 9.6pt; font-weight: normal; font-style: italic; margin: 3mm 0 1.2mm; }
.nagl.czesc { font-size: 15pt; font-weight: bold; letter-spacing: 0.06em; text-transform: uppercase; color: var(--akcent);
              margin: 0 0 6mm; padding: 0 0 2mm; border-bottom: 1.6pt solid var(--akcent); }
.nagl.zal { font-size: 13pt; font-weight: bold; color: var(--akcent); margin: 0 0 5mm; padding-bottom: 1.6mm;
            border-bottom: 1.2pt solid var(--akcent); }
.nagl.zal .nr { min-width: 0; white-space: nowrap; }
.pierwszy .nagl.g1:first-child, .nowa-strona > .nagl.g1:first-child { margin-top: 0; }

/* ------------------------------------------------------------------------------------------ listy */
ul, ol { margin: 0 0 2.4mm; padding-left: 6mm; }
li { margin: 0 0 0.9mm; text-align: justify; }
ul { list-style: none; }
ul > li { position: relative; }
ul > li::before { content: "–"; position: absolute; left: -4.5mm; color: var(--akcent-j); }
ol { list-style: none; counter-reset: pkt; }
ol > li { position: relative; counter-increment: pkt; }
ol > li::before { content: counter(pkt) ")"; position: absolute; left: -6mm; width: 5mm; text-align: right; }
ol.lit > li::before { content: counter(pkt, lower-alpha) ")"; }
dl { margin: 0 0 2.5mm; display: grid; grid-template-columns: 42mm 1fr; gap: 1mm 4mm; }
dt { color: var(--szary); } dd { margin: 0; }

/* ------------------------------------------------------------------------------------------ tabele */
figure.tabela { margin: 3.5mm 0 4.5mm; }
table.tab { width: 100%; border-collapse: collapse; font-size: 8.3pt; line-height: 1.3; }
.tab-tyt { text-align: left; font-size: 8.8pt; padding: 0 0 1.6mm; color: var(--ink); break-after: avoid; break-inside: avoid; }
.tab-tyt .et { font-weight: bold; color: var(--akcent); margin-right: 1.5mm; }
table.tab thead { display: table-header-group; }
table.tab th { background: var(--tlo-nagl); font-weight: bold; text-align: left; vertical-align: bottom;
               padding: 1.3mm 1.6mm; border-top: 0.9pt solid var(--akcent); border-bottom: 0.6pt solid var(--akcent); }
table.tab th .jedn { display: block; font-weight: normal; color: var(--szary); font-size: 7.4pt; }
table.tab td { padding: 1.05mm 1.6mm; border-bottom: 0.35pt solid var(--linia-m); vertical-align: top; }
table.tab tbody tr { break-inside: avoid; }
table.tab tbody tr:last-child td { border-bottom: 0.9pt solid var(--akcent); }
table.tab tr.suma td { font-weight: bold; border-top: 0.7pt solid var(--akcent); background: var(--tlo-jasne); }
table.tab tr.grupa td { font-weight: bold; background: var(--tlo-jasne); color: var(--akcent); padding-top: 1.4mm; }
table.tab tr.pod td { color: var(--szary); font-style: italic; }
table.tab .num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
table.tab .c { text-align: center; }
table.tab .lp { width: 7mm; color: var(--szary); text-align: right; }
table.tab .ok { color: #1e6b3a; font-weight: bold; white-space: nowrap; }
table.tab .nok { color: var(--czerw); font-weight: bold; white-space: nowrap; }
table.tab .nd { color: var(--szary); white-space: nowrap; }
table.tab.zwarta { font-size: 7.9pt; }
figure.tabela figcaption.uwagi { font-size: 7.4pt; color: var(--szary); margin-top: 1.2mm; line-height: 1.35; text-align: left; }
figure.tabela figcaption.uwagi p { margin: 0 0 0.6mm; text-align: left; }

/* ------------------------------------------------------------------------------------------ ilustracje */
figure.ilustr { margin: 4mm 0 4.5mm; text-align: center; break-inside: avoid; }
figure.ilustr img, figure.ilustr svg { max-width: 100%; height: auto; }
figure.ilustr figcaption { font-size: 8.3pt; margin-top: 1.5mm; text-align: center; }
figure.ilustr figcaption .et { font-weight: bold; color: var(--akcent); margin-right: 1.5mm; }

/* ------------------------------------------------------------------------------------------ znaczniki (rejestr E.1) */
.zn { border-radius: 0.6mm; padding: 0 0.6mm; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
.zn-uzup { background: #fff0b3; color: #5c4700; border-bottom: 0.6pt dashed #b48a00; }
.zn-przykl { background: #fbe1e1; color: #85191c; }
.zn-zewn { background: #dcebfa; color: #0f3c66; border-bottom: 0.6pt dashed #2d6aa3; }
.zn-status { color: #7a5a00; font-size: 85%; font-weight: bold; }

/* ------------------------------------------------------------------------------------------ znak wodny */
.znak-wodny { position: fixed; left: -10mm; right: -10mm; top: 120mm; text-align: center; transform: rotate(-35deg);
              font-size: 30pt; font-weight: bold; letter-spacing: 0.1em; color: rgba(163, 38, 42, 0.055);
              white-space: nowrap; z-index: -1; }

/* ------------------------------------------------------------------------------------------ strona tytułowa */
section.st { page: tytulowa; break-after: page; font-size: 9pt; height: 266mm; position: relative; overflow: hidden; }
.st .et { display: block; font-size: 6.6pt; letter-spacing: 0.09em; text-transform: uppercase; color: var(--szary); margin-bottom: 0.6mm; }
.st-gora { display: flex; justify-content: space-between; align-items: flex-end; padding-bottom: 2.5mm;
           border-bottom: 0.6pt solid var(--akcent); }
.st-gora .st-stadium { text-align: right; }
.st-gora .b { font-weight: bold; letter-spacing: 0.05em; color: var(--akcent); }
.st-element { display: flex; gap: 6mm; align-items: center; margin: 8mm 0 5mm; }
.st-kod { flex: 0 0 auto; min-width: 20mm; height: 20mm; padding: 0 3mm; border: 1.6pt solid var(--akcent); color: var(--akcent);
          display: flex; align-items: center; justify-content: center; font-size: 15pt; font-weight: bold; letter-spacing: 0.04em; }
.st-nazwa { font-size: 18pt; line-height: 1.15; font-weight: bold; letter-spacing: 0.03em; color: var(--akcent); text-transform: uppercase; }
.st-podtytul { font-size: 10pt; margin-top: 1.5mm; color: var(--ink); }
.st-tom { font-size: 8pt; margin-top: 1.8mm; color: var(--szary); letter-spacing: 0.02em; }
.st-status { border: 1.3pt solid var(--czerw); color: var(--czerw); padding: 1.5mm 3.5mm; margin: 0 0 4mm;
             display: flex; align-items: center; gap: 5mm; }
.st-status b { font-size: 12pt; letter-spacing: 0.07em; white-space: nowrap; }
.st-status span { font-size: 7pt; line-height: 1.3; color: #6d1f22; }
table.st-dane { width: 100%; border-collapse: collapse; margin-bottom: 4mm; font-size: 8.4pt; line-height: 1.3; }
table.st-dane th { width: 42mm; text-align: left; vertical-align: top; font-weight: normal; color: var(--szary);
                   font-size: 6.9pt; letter-spacing: 0.05em; text-transform: uppercase; padding: 1.35mm 3mm 1.2mm 0; }
table.st-dane td { padding: 1.1mm 0; vertical-align: top; }
table.st-dane tr { border-bottom: 0.35pt solid var(--linia-m); }
table.st-dane tr:first-child { border-top: 0.35pt solid var(--linia-m); }
table.st-dane .duze { font-size: 9.2pt; font-weight: bold; }
table.st-autorzy { width: 100%; border-collapse: collapse; font-size: 7.1pt; line-height: 1.22; }
.st-autorzy-tyt { text-align: left; font-size: 6.6pt; letter-spacing: 0.09em; text-transform: uppercase;
                  color: var(--szary); padding-bottom: 1.2mm; break-after: avoid; }
table.st-autorzy th { text-align: left; font-weight: bold; background: var(--tlo-nagl); padding: 1.1mm 1.4mm;
                      border-top: 0.8pt solid var(--akcent); border-bottom: 0.5pt solid var(--akcent); font-size: 7pt; }
table.st-autorzy td { padding: 0.9mm 1.3mm; border-bottom: 0.35pt solid var(--linia); vertical-align: top; }
table.st-autorzy td.podpis { height: 9mm; border-left: 0.35pt solid var(--linia); }
table.st-autorzy tr.spr td { color: var(--szary); height: auto; }
.st-dol { position: absolute; left: 0; right: 0; bottom: 0; }
.st-dol-siatka { display: grid; grid-template-columns: 0.8fr 1.1fr 1.7fr; gap: 3mm; padding-top: 2mm;
                 border-top: 0.6pt solid var(--akcent); font-size: 8.1pt; }
.st-uwaga { font-size: 6.6pt; color: var(--szary); margin: 2mm 0 0; line-height: 1.35; text-align: left; }
.st-zawartosc { font-size: 7.8pt; line-height: 1.3; }
.st-zawartosc span.el { white-space: nowrap; }

section.st-zal { break-after: page; }

/* ------------------------------------------------------------------------------------------ spis treści */
section.spis { break-after: page; }
.spis-tyt { font-size: 15pt; font-weight: bold; letter-spacing: 0.06em; text-transform: uppercase; color: var(--akcent);
            margin: 0 0 5mm; padding-bottom: 2mm; border-bottom: 1.6pt solid var(--akcent); }
.spis-podst { font-size: 7.2pt; color: var(--szary); margin: -3mm 0 4mm; }
.spis-grupa { font-size: 7pt; font-weight: bold; letter-spacing: 0.1em; text-transform: uppercase; color: var(--akcent-j);
              margin: 4.2mm 0 1.4mm; padding-bottom: 0.8mm; border-bottom: 0.4pt solid var(--linia-m); break-after: avoid; }
a.spis-w { display: flex; align-items: baseline; break-inside: avoid; margin: 0 0 1.1mm; }
a.spis-w .nr { flex: 0 0 auto; min-width: 9mm; padding-right: 1.6mm; }
a.spis-w .t { flex: 0 1 auto; }
a.spis-w .kr { flex: 1 1 8mm; border-bottom: 0.9pt dotted #98a2ad; margin: 0 1.6mm; position: relative; top: -0.9mm; min-width: 6mm; }
a.spis-w .pg { flex: 0 0 15mm; text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
a.spis-w.p1 { font-weight: bold; margin-top: 1.8mm; }
a.spis-w.p2 { padding-left: 9mm; font-size: 9pt; }
a.spis-w.p2 .nr { min-width: 11mm; }
a.spis-w.p3 { padding-left: 20mm; font-size: 8.6pt; color: var(--szary); }
a.spis-w.rys .nr { min-width: 22mm; font-weight: bold; }
a.spis-w.rys { font-weight: normal; margin-top: 0; }
a.spis-w.rys .pg { color: var(--szary); font-size: 8.4pt; }
a.spis-w.el { font-size: 10.2pt; font-weight: bold; color: var(--akcent); margin-top: 4.5mm; }
.spis-legenda { font-size: 7.2pt; color: var(--szary); margin-top: 5mm; border-top: 0.4pt solid var(--linia-m); padding-top: 1.5mm; }

/* ------------------------------------------------------------------------------------------ oświadczenia */
section.osw { break-before: page; font-size: 9.3pt; }
.osw-miejsce { text-align: right; margin-bottom: 5mm; }
.osw-tyt { text-align: center; font-size: 13pt; font-weight: bold; letter-spacing: 0.08em; color: var(--akcent); margin: 0 0 1.5mm; }
.osw-podst { text-align: center; font-size: 8pt; color: var(--szary); margin: 0 12mm 4.5mm; line-height: 1.38; white-space: pre-line; }
table.osw-dane { width: 100%; border-collapse: collapse; margin: 0 0 4.5mm; font-size: 8.5pt; line-height: 1.33; }
table.osw-dane th { width: 36mm; text-align: left; font-weight: normal; color: var(--szary); vertical-align: top;
                    padding: 0.9mm 3mm 0.9mm 0; font-size: 7.8pt; }
table.osw-dane td { padding: 0.9mm 0; vertical-align: top; }
table.osw-dane tr { border-bottom: 0.35pt solid var(--linia-m); }
.osw-tresc p { text-align: justify; line-height: 1.45; }
.osw-klauzula { margin: 5mm 0; padding: 2.5mm 4mm; border-left: 2pt solid var(--akcent); background: var(--tlo-jasne); font-weight: bold; }
.osw-wzor { border: 1pt solid #8a6d00; background: #fff8dc; color: #4d3d00; padding: 2mm 3.5mm; margin: 0 0 6mm; font-size: 8pt; line-height: 1.4; }
.osw-wzor b { letter-spacing: 0.06em; }
.wybor { display: flex; gap: 3mm; margin: 0 0 2.6mm; align-items: flex-start; }
.wybor .pole { flex: 0 0 4.2mm; height: 4.2mm; border: 0.8pt solid var(--ink); text-align: center; line-height: 4.2mm;
               font-size: 9pt; font-weight: bold; margin-top: 0.3mm; }
.wybor .opis { flex: 1 1 auto; text-align: justify; }
.osw-pouczenie { font-size: 7.6pt; color: var(--szary); margin-top: 6mm; line-height: 1.4; }
.osw-pouczenie p { text-align: left; margin-bottom: 1mm; }

.zal-etykieta { text-align: right; font-size: 7.4pt; font-weight: bold; letter-spacing: 0.1em; text-transform: uppercase;
                color: var(--akcent); margin: 0 0 4mm; }

/* ------------------------------------------------------------------------------------------ podpisy */
.podpisy { display: grid; grid-template-columns: 1fr 1fr; gap: 4mm 6mm; margin: 6mm 0 2mm; break-inside: avoid; }
.podpisy.jeden { grid-template-columns: 1fr; margin-left: 50%; }
.podpisy.trzy { grid-template-columns: 1fr 1fr 1fr; gap: 3mm 4mm; }
.karta-podpisu { border: 0.5pt solid var(--linia); padding: 1.8mm 2.6mm 1.8mm; break-inside: avoid; font-size: 7.6pt; line-height: 1.3; }
.karta-podpisu .rola { font-size: 6.8pt; letter-spacing: 0.08em; text-transform: uppercase; color: var(--akcent); font-weight: bold; }
.karta-podpisu .pole-podpisu { height: 11mm; border-bottom: 0.5pt dotted #7c8793; margin: 1.2mm 0 1mm; }
.karta-podpisu .opis-pola { font-size: 6.6pt; color: var(--szary); }
.podpis-uwaga { font-size: 6.9pt; color: var(--szary); margin-top: 1.5mm; }

/* ------------------------------------------------------------------------------------------ BIOZ, karty, strony zastępcze */
section.bioz-st { page: tytul-wew; break-before: page; break-after: page; }
section.bioz-st .tyt-duzy { text-align: center; margin: 14mm 0 10mm; }
section.bioz-st .tyt-duzy .l1 { font-size: 17pt; font-weight: bold; letter-spacing: 0.05em; color: var(--akcent); }
section.bioz-st .tyt-duzy .l2 { font-size: 11pt; margin-top: 2mm; }
section.bioz-st .tyt-duzy .l3 { font-size: 8.3pt; color: var(--szary); margin-top: 2mm; }
.ramka { border: 0.6pt solid var(--linia); padding: 3mm 4mm; margin: 3mm 0; break-inside: avoid; }
.ramka.akcent { border-color: var(--akcent); border-width: 0.9pt; }
.wniosek { border-left: 2.2pt solid var(--akcent); background: var(--tlo-jasne); padding: 2.4mm 4mm; margin: 3mm 0 4mm; break-inside: avoid; }
.wniosek.alarm { border-left-color: var(--czerw); }
section.zewn { break-before: page; }
.zewn-box { border: 1.2pt dashed #2d6aa3; background: #f1f7fd; padding: 10mm 10mm; margin: 22mm 0 8mm; text-align: center; }
.zewn-box .l1 { font-size: 8pt; letter-spacing: 0.12em; color: #2d6aa3; font-weight: bold; }
.zewn-box .l2 { font-size: 14pt; font-weight: bold; margin: 3mm 0 2mm; color: var(--ink); }
.zewn-box .l3 { font-size: 9pt; color: var(--szary); }
section.karta-rys { break-before: page; }
.info-siatka { display: grid; grid-template-columns: 44mm 1fr; border-top: 0.35pt solid var(--linia-m); margin-bottom: 6mm; font-size: 8.8pt; }
.info-siatka > div { padding: 1.4mm 0; border-bottom: 0.35pt solid var(--linia-m); }
.info-siatka > div.k { color: var(--szary); font-size: 7.2pt; letter-spacing: 0.05em; text-transform: uppercase; padding-right: 3mm; }
